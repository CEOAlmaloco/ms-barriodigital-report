# Oracle Autonomous. Copiá este archivo a .env y completá los valores.
# NUNCA subas .env ni el wallet a git.
# Es el mismo esquema, wallet y usuario que ms-barriodigital-requests.
#
# Ejemplo (el alias debe existir en el tnsnames.ora del wallet):
# ORACLE_URL=jdbc:oracle:thin:@barriodig_low?TNS_ADMIN=C:/Users/TU_USUARIO/oracle-wallets/barriodigital

ORACLE_URL=
ORACLE_USER=
ORACLE_PASSWORD=

# Carpeta local del wallet descomprimido (fuera del repo). Spring la usa como TNS_ADMIN.
ORACLE_WALLET_DIR=

# Kafka (requests.events): localhost:9092,localhost:9093,localhost:9094 en local; KAFKA_HOST_IP:9092,... en Docker o EC2.
KAFKA_BOOTSTRAP_SERVERS=
